# Backend environment variables — copy to .env and fill in your values

ANTHROPIC_API_KEY=your_anthropic_api_key_here
PORT=4000
MONGODB_URI=your_mongodb_atlas_connection_string_here
ADMIN_USERNAME=your_admin_username_here
ADMIN_PASSWORD=your_admin_password_here

# Mappls REST API key (static key from https://about.mappls.com/api/)
# Used by the /api/nearby proxy to call the Mappls Nearby API.
# Never set this as a VITE_ variable — keep it server-side only.
MAPPLS_REST_KEY=your_mappls_static_rest_api_key_here
